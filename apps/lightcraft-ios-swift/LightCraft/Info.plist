<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's Info.plist keys, for both builds: xtool merges them over its default Info.plist, and
     the Xcode project (../xcode) over the one it generates. SwiftUI's App is scene-based: no
     delegate class to name. -->
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>LightCraft</string>
    <!-- sync with a LightCraft server on the home network (docs/sync.md); iOS asks once -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>LightCraft syncs your library with your own LightCraft server, which can be on this network.</string>
    <!-- Save to Photos (exports); importing uses the Photos picker, which needs no access -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>LightCraft saves the photos you export to your photo library.</string>
    <!-- more than one window on an iPad (Window ▸ Second Window); a mirroring external display
         shows the second window's photo (ExternalDisplayDelegate, SecondWindow.swift) -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>External Display</string>
                    <key>UISceneDelegateClassName</key>
                    <string>LCExternalDisplayDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
