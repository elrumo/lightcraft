# The LightBites Server's name, links, icon and telemetry: the LightCraft sync server built under LightBites' name.
# apps/lightcraft-server/build.rs reads these (src/brand.rs lists them); build.sh, the Dockerfile's SERVER_BRAND
# build argument, .github/workflows/server.yml and tools/release-server.sh source this file. Shell syntax, so a
# value already in the environment wins where it says so. Fork-only: nothing in the server's source names LightBites.
LIGHTCRAFT_SERVER_PRODUCT=LightBites
LIGHTCRAFT_SERVER_COMMAND=lightbites-server
LIGHTCRAFT_SERVER_MENUBAR=lightbites-menubar
LIGHTCRAFT_SERVER_GUIDE_URL=https://lightbites.app/server
LIGHTCRAFT_SERVER_DOWNLOADS_URL=https://github.com/elrumo/lightbites-server
LIGHTCRAFT_SERVER_ICON=packaging/lightbites-server/icon.png
LIGHTCRAFT_SERVER_TELEMETRY_URL=https://lightbites.app/api/telemetry/server
# a public ingest key
LIGHTCRAFT_SERVER_BUGSINK_DSN=${LIGHTCRAFT_SERVER_BUGSINK_DSN:-https://864779c6953e435696525549a16dae9c@bugs.eliasruiz.com/11}
